# Proveedor de LLM (gratuito por defecto, ver MD3)
LLM_PROVIDER=gemini
LLM_API_KEY=

# Telegram (Fase 1)
TELEGRAM_BOT_TOKEN=

# Discord (Fase 2+)
DISCORD_BOT_TOKEN=

# Firebase (Fase 2)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=./database/serviceAccountKey.json

# Google Calendar (Fase 4)
GOOGLE_CALENDAR_CREDENTIALS_PATH=

# Android pilot: a random, temporary connection key (not the Gemini API key).
APP_SHARED_SECRET=
GEMINI_MODELS=gemini-3.1-flash-lite

# Used by scripts/run_demo.py for the three services on this computer.
ENABLED_TOOLS=chat,contact_list,contact_add,telegram_send
